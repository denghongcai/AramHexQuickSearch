{
  "name": "aramhex-quick-search",
  "compatibility_date": "2026-10-01",
  // 自定义域声明式管理：CI 令牌需含 Worker 脚本编辑（帐户级）+
  // dhc.house 的 区域读取 / DNS 写入 / SSL 和证书编辑 三项区域权限
  "routes": [{ "pattern": "aramhex.dhc.house", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
